<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11 package visibility: launcher apps (installedApps, LaunchApp) and https handlers (deeplinks). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Android 10 only: MediaProjection screen capture (see ProjectionCapture). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>
        <!-- One-tap system consent dialog for MediaProjection (Android 10). -->
        <activity
            android:name="dev.xiaoman.hands.ProjectionConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Keeps the MediaProjection grant alive while the session captures the screen (Android 10). -->
        <service
            android:name="dev.xiaoman.hands.ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Must be exported so the system can bind it; only holders of BIND_ACCESSIBILITY_SERVICE (the system) can. -->
        <service
            android:name="dev.xiaoman.hands.XiaomanAccessibilityService"
            android:exported="true"
            android:label="@string/xiaoman_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/xiaoman_accessibility" />
        </service>
    </application>
</manifest>
